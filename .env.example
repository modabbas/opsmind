# Copy to .env (locally) or paste into Replit > Tools > Secrets.
# Everything here is OPTIONAL — with no values set, the app runs on local
# stores and a rule-based answerer, and /api/health says so.

# ---- LLM: any OpenAI-compatible endpoint ----
# Groq has a free tier and is the quickest to demo with.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ---- Optional: remote embeddings instead of local TF-IDF ----
EMBEDDINGS_URL=
EMBEDDINGS_MODEL=text-embedding-3-small

# ---- Optional: real databases instead of the local fallbacks ----
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=opsmind
INFLUX_BUCKET=metrics

MONGO_URI=
MONGO_DB=opsmind

DATABASE_URL=

# ---- Tuning (defaults chosen with eval/run_eval.py) ----
CHUNK_SIZE=110
CHUNK_OVERLAP=25
TOP_K=4
ZSCORE_THRESHOLD=3.4
