# Replit configuration — press Run and the API + dashboard come up together.
modules = ["python-3.11"]
entrypoint = "main.py"
run = "bash start.sh"

[nix]
channel = "stable-23_11"

[env]
PORT = "8000"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "pip install -r requirements.txt && gunicorn main:app --bind 0.0.0.0:8000 --workers 2 --timeout 90"]
