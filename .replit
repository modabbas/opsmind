modules = ["python-3.11"]
entrypoint = "main.py"
run = "bash start.sh"

[nix]
channel = "stable-23_11"

[env]
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pip install -r requirements.txt"]
run = ["sh", "-c", "gunicorn main:app --bind 0.0.0.0:5000 --workers 2 --timeout 90"]
